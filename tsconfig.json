{
  "compilerOptions": {
    "target": "ES2022",
    /*
     * No DOM. The layering test proves no DOM identifier is referenced; leaving the
     * lib out means the compiler proves it too, and a stray `document` fails to build
     * rather than failing a test someone might skip.
     */
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "vitest.config.ts"]
}
